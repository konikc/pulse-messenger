# ============================================================
#  Pulse Messenger — переменные окружения
#  Скопируйте этот файл в .env.production (или .env.local для
#  локальной разработки) и заполните значения.
#  НИКОГДА не коммитьте реальные секреты в git!
# ============================================================

# --- База данных (Neon Postgres) --------------------------------
# Строка подключения к вашей базе. Берётся в панели Neon:
# Project -> Connection Details -> Connection string (Pooled).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"
# Прямое (непулинговое) подключение — нужно для миграций.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# --- Neon Auth (аутентификация) ---------------------------------
# Базовый URL Neon Auth для вашего проекта (Neon -> Auth -> Configuration).
NEON_AUTH_BASE_URL="https://api.stack-auth.com/api/v1/projects/<project-id>"
# Секрет для подписи cookie сессии. Сгенерируйте так:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="сгенерируйте_длинную_случайную_строку"

# --- Публичный адрес сайта --------------------------------------
# Ваш домен (с https). Используется для ссылок и редиректов.
NEXT_PUBLIC_APP_URL="https://ваш-домен.ru"

# --- Хранилище файлов (Vercel Blob) — опционально ---------------
# Нужно для отправки картинок / файлов / голосовых.
# Токен берётся в Vercel -> Storage -> Blob -> Tokens.
BLOB_READ_WRITE_TOKEN=""

# --- Звонки (LiveKit) — опционально -----------------------------
# Нужно только если хотите аудио/видеозвонки.
LIVEKIT_URL="wss://ваш-проект.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
