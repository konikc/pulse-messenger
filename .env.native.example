# URL опубликованного Pulse для Android и production desktop.
PULSE_APP_URL=https://pulse-messenger-eight.vercel.app

# Проверка обновлений GitHub Releases.
GITHUB_OWNER=konikc
GITHUB_REPO=pulse-messenger
NEXT_PUBLIC_APP_VERSION=0.1.5

# База данных и Neon Auth (обязательны для запуска сервера).
DATABASE_URL=postgres://user:pass@host:5432/pulse
NEON_AUTH_BASE_URL=https://your-project.neon.tech
NEON_AUTH_COOKIE_SECRET=change-me-min-32-chars
